<Window x:Class="ShellIsland.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始"
        Width="680" Height="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="36,9,14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                <GradientStop Color="#F20B1018" Offset="0"/>
                <GradientStop Color="#F2170F1E" Offset="0.55"/>
                <GradientStop Color="#F20B1018" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#C4070A0F" CornerRadius="12,0,0,12">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#FF0078D7">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="用户" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="PowerButton" Style="{StaticResource FlatButton}" Width="40" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,14" HorizontalAlignment="Center" Click="PowerButton_Click" ToolTip="电源">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20,18,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="258"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,14">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#AFFFFFFF" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="搜索应用、设置和文档" Margin="36,0,0,0" Foreground="#6FFFFFFF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Row="1" Margin="2,0,2,6">
                    <TextBlock Text="已固定" FontSize="12" Foreground="#CFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="全部" FontSize="10" Foreground="#70FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="96"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF12304D" CornerRadius="9" Padding="15">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockTime" Text="09:41" FontSize="34" FontWeight="Light"/>
                                    <TextBlock x:Name="ClockDate" Text="10月20日 周一" FontSize="11" Foreground="#BFFFFFFF" Margin="2,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="时钟" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3A1C5C" Offset="0"/>
                                        <GradientStop Color="#FF8B2F62" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="PhotoTile" Stretch="UniformToFill"/>
                                <TextBlock x:Name="PhotoFallback" Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#88FFFFFF"/>
                                <TextBlock Text="图片" FontSize="9" Foreground="#BFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <UniformGrid x:Name="PinnedApps" Grid.Row="2" Columns="6"/>
                </Grid>

                <Grid Grid.Row="3" Margin="2,0,2,6">
                    <TextBlock Text="所有应用" FontSize="12" Foreground="#CFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppCount" FontSize="10" Foreground="#70FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="AppsList"
                         Grid.Row="5"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="AppsList_MouseDoubleClick"
                         KeyDown="AppsList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#18FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#28FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="7" Background="#2AFFFFFF">
                                    <TextBlock Text="{Binding Initial}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>