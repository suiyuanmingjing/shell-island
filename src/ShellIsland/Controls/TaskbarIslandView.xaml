<UserControl x:Class="ShellIsland.Controls.TaskbarIslandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="48">
    <Border x:Name="Root" Background="#CC1C1C1C" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="4"
            MouseLeftButtonUp="OnClick" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Grid>
            <Border Width="30" Height="30" CornerRadius="6" Background="#0FFFFFFF" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15" Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="Artwork" Stretch="UniformToFill" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
