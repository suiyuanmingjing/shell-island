<Window x:Class="ShellIsland.IslandPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShellIsland"
        Width="430" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="34,8,12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F41B1B1B" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="Caption" Text="搜索" FontSize="11" Foreground="#9FFFFFFF" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="26" Height="26" Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索应用或网页…" Margin="34,0,0,0" Foreground="#70FFFFFF" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#AFFFFFFF" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel x:Name="MusicPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="9" Background="#28FFFFFF" ClipToBounds="True">
                                <Image x:Name="Artwork" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <TextBlock x:Name="TrackTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TrackArtist" FontSize="12" Foreground="#AFFFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Click="Previous_Click" ToolTip="上一首">
                                        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="40" Height="30" Click="PlayPause_Click" ToolTip="播放 / 暂停">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Click="Next_Click" ToolTip="下一首">
                                        <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="TrackProgress" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#FF4CC2FF" Background="#22FFFFFF" BorderThickness="0"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="PositionText" Text="00:00" FontSize="10" Foreground="#80FFFFFF"/>
                            <TextBlock x:Name="DurationText" Text="00:00" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="SearchPanel">
                        <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Foreground="White" MaxHeight="122" MouseDoubleClick="ResultsList_MouseDoubleClick" KeyDown="ResultsList_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="B" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#20FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="6" Background="#2AFFFFFF">
                                            <TextBlock Text="{Binding Initial}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyHint" Text="输入后搜索本机应用，Enter 打开第一条，或用网页搜索。" Foreground="#80FFFFFF" FontSize="12" TextWrapping="Wrap" Margin="2,12,2,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="Enter 打开 · Esc 关闭" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"/>
                <Button x:Name="WebButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Padding="10,4" Click="WebButton_Click" ToolTip="用浏览器搜索">
                    <TextBlock Text="网页搜索" FontSize="11" Foreground="#BFFFFFFF"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>