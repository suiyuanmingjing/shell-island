<Application x:Class="ShellIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="PanelBrush" Color="#F21B1B1B"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D7"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Resources>
</Application>
